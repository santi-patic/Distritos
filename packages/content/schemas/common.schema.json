{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://distritos.local/schemas/common.schema.json",
  "definitions": {
    "kindId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "int": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "nonNegInt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "posInt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "permille": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "hex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "properties": { "q": { "$ref": "#/definitions/int" }, "r": { "$ref": "#/definitions/int" } }
    },
    "weighted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "weight"],
      "properties": {
        "kind": { "$ref": "#/definitions/kindId" },
        "weight": { "$ref": "#/definitions/nonNegInt" }
      }
    },
    "stocks": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/definitions/nonNegInt" }
    }
  }
}
