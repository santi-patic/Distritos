{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://distritos.local/schemas/recados.schema.json",
  "title": "Recados y rutas",
  "description": "Lo que hay que llevar de un sitio a otro, lo que paga y lo que cuesta cada parada de una ruta.",
  "type": "object",
  "additionalProperties": false,
  "required": ["currency", "stopSeconds", "maxStops", "kinds"],
  "properties": {
    "currency": {
      "$ref": "common.schema.json#/definitions/kindId"
    },
    "stopSeconds": {
      "$ref": "common.schema.json#/definitions/seconds",
      "description": "Trabajo con luz de cada parada (cargar, descargar, apuntar en la pizarra)."
    },
    "firstStopSeconds": {
      "$ref": "common.schema.json#/definitions/seconds",
      "description": "Lo mismo en la primera ruta del jugador (entrada fácil)."
    },
    "maxStops": {
      "$ref": "common.schema.json#/definitions/posInt"
    },
    "kinds": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "size", "pay"],
        "properties": {
          "to": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/definitions/kindId"
            },
            "description": "Tipos de sitio a los que puede ir."
          },
          "size": {
            "$ref": "common.schema.json#/definitions/posInt",
            "description": "Bultos que ocupa."
          },
          "pay": {
            "$ref": "common.schema.json#/definitions/nonNegInt"
          },
          "expiresSeconds": {
            "$ref": "common.schema.json#/definitions/seconds",
            "description": "Lo que aguanta en su sitio sin que nadie lo recoja; sin esto, no caduca."
          }
        }
      }
    }
  }
}
