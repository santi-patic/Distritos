{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://distritos.local/schemas/terrains.schema.json",
  "title": "Terrenos",
  "type": "object",
  "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["category"],
    "properties": { "category": { "enum": ["ground", "water", "wood", "stone"] } }
  }
}
