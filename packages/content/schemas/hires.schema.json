{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://distritos.local/schemas/hires.schema.json",
  "title": "Contratación de obreros",
  "description": "Qué cuesta contratar cada tipo de obrero; hace falta cama libre y llega al amanecer.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["cost"],
    "properties": {
      "cost": {
        "$ref": "common.schema.json#/definitions/amounts"
      }
    }
  }
}
