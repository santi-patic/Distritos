{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://distritos.local/schemas/templates.schema.json",
  "title": "Plantillas de distrito",
  "type": "object",
  "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["kind", "plots", "common"],
    "properties": {
      "kind": { "enum": ["district", "incursion", "charge", "dispute"] },
      "plots": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "archetype", "anchor", "radius"],
          "properties": {
            "id": { "type": "string", "pattern": "^p[0-9]+$" },
            "archetype": { "$ref": "common.schema.json#/definitions/kindId" },
            "anchor": { "$ref": "common.schema.json#/definitions/hex" },
            "radius": { "type": "integer", "minimum": 0, "maximum": 8 }
          }
        }
      },
      "common": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["archetype", "sectors"],
            "properties": {
              "archetype": { "$ref": "common.schema.json#/definitions/kindId" },
              "sectors": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/hex" } }
            }
          }
        ]
      }
    }
  }
}
