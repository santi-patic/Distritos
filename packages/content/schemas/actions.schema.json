{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://distritos.local/schemas/actions.schema.json",
  "title": "Acciones",
  "type": "object",
  "additionalProperties": false,
  "required": ["reveal"],
  "properties": {
    "reveal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "costJ", "seconds"],
      "properties": {
        "resource": {
          "$ref": "common.schema.json#/definitions/kindId"
        },
        "costJ": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": "integer",
          "minimum": 0
        },
        "firstSeconds": {
          "$ref": "common.schema.json#/definitions/seconds",
          "description": "La primera vez del jugador (entrada fácil)."
        }
      }
    }
  }
}
