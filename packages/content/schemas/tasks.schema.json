{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://distritos.local/schemas/tasks.schema.json",
  "title": "Tareas de los obreros",
  "description": "Qué se hace sobre un elemento, cuánto dura con luz de trabajo, qué cuesta y qué deja al terminar.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["at", "seconds"],
    "properties": {
      "seconds": {
        "$ref": "common.schema.json#/definitions/seconds"
      },
      "firstSeconds": {
        "$ref": "common.schema.json#/definitions/seconds",
        "description": "La primera vez del jugador (entrada fácil)."
      },
      "cost": {
        "$ref": "common.schema.json#/definitions/amounts",
        "description": "Se cobra al dar la orden."
      },
      "at": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "common.schema.json#/definitions/kindId"
        }
      },
      "gives": {
        "$ref": "common.schema.json#/definitions/amounts"
      },
      "into": {
        "enum": ["self", "inventory"]
      },
      "collect": {
        "$ref": "common.schema.json#/definitions/kindId"
      },
      "clean": {
        "type": "boolean"
      },
      "tool": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "seconds"],
        "description": "Variante si el jugador tiene un elemento de este tipo (el taller).",
        "properties": {
          "seconds": {
            "$ref": "common.schema.json#/definitions/seconds"
          },
          "firstSeconds": {
            "$ref": "common.schema.json#/definitions/seconds",
            "description": "La primera vez del jugador (entrada fácil)."
          },
          "cost": {
            "$ref": "common.schema.json#/definitions/amounts",
            "description": "Se cobra al dar la orden."
          },
          "kind": {
            "$ref": "common.schema.json#/definitions/kindId"
          }
        }
      },
      "jornada": {
        "type": "boolean",
        "description": "P9: dura lo que quede de luz de trabajo al llegar (de noche, la jornada siguiente), o menos si antes se llena donde va lo producido; gives es lo que rinde cada seconds de trabajo. La primera vez (firstSeconds) sigue siendo corta y fija."
      }
    }
  }
}
